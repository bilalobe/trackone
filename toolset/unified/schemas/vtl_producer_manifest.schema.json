{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bilalobe/trackone/main/toolset/unified/schemas/vtl_producer_manifest.schema.json",
  "title": "VTL producer manifest",
  "type": "object",
  "properties": {
    "version": {"const": 1},
    "ledger_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "segment_number": {"$ref": "#/$defs/uint64_decimal"},
    "commitment_profile_id": {"type": "string"},
    "disclosure_class": {"enum": ["A", "B", "C"]},
    "artifacts": {"$ref": "#/$defs/artifacts"},
    "anchoring": {"$ref": "#/$defs/anchoring"},
    "extensions": {"type": "object"}
  },
  "required": ["version", "ledger_id", "segment_number", "commitment_profile_id", "disclosure_class", "artifacts", "anchoring"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"anchoring": {"properties": {"tsa": {"properties": {"status": {"const": "present"}}}}}}},
      "then": {"properties": {"artifacts": {"required": ["tsa_tsr"]}}},
      "else": {"properties": {"artifacts": {"not": {"required": ["tsa_tsr"]}}}}
    }
  ],
  "$defs": {
    "uint64_decimal": {"type": "string", "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0][0-9]|1844674407370955161[0-5])$"},
    "artifact_ref": {
      "type": "object",
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "required": ["path", "sha256"],
      "additionalProperties": false
    },
    "record_batch_opening": {
      "type": "object",
      "properties": {
        "batch_number": {"$ref": "#/$defs/uint64_decimal"},
        "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact_ref"}}
      },
      "required": ["batch_number", "records"],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "segment_cbor": {"$ref": "#/$defs/artifact_ref"},
        "predecessor_segment_cbor": {"$ref": "#/$defs/artifact_ref"},
        "record_batches": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record_batch_opening"}},
        "tsa_req": {"$ref": "#/$defs/artifact_ref"},
        "tsa_tsr": {"$ref": "#/$defs/artifact_ref"},
        "extensions": {"type": "object", "additionalProperties": {"$ref": "#/$defs/artifact_ref"}}
      },
      "required": ["segment_cbor"],
      "additionalProperties": false
    },
    "anchoring": {
      "type": "object",
      "properties": {
        "tsa": {
          "type": "object",
          "properties": {"status": {"enum": ["present", "pending", "unavailable"]}},
          "required": ["status"],
          "additionalProperties": false
        }
      },
      "required": ["tsa"],
      "additionalProperties": false
    }
  }
}
